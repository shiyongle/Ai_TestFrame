# 数据库配置
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=test_system
MYSQL_USER=testuser
MYSQL_PASSWORD=testpass

# Docker 镜像标签
IMAGE_TAG=latest

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true

# 应用配置
DEBUG=false
LOG_LEVEL=INFO
AUTH_SECRET_KEY=ai_testframe_default_secret

# CORS 配置
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://your-domain.com"]

# AI / RAG 配置
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GLM_API_KEY=
TONGYI_API_KEY=
DEEPSEEK_API_KEY=
NEWAPI_API_KEY=
NEWAPI_BASE_URL=
NEWAPI_CHAT_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=siliconflow
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_MAX_FEATURES=1000
CHROMA_PERSIST_DIR=/app/data/chroma
WORKFLOW_MAX_EXECUTION_TIME=3600
WORKFLOW_MAX_CONCURRENT=10

# 前端配置
REACT_APP_API_URL=/api
